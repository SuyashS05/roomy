rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validImageUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /listing_images/{uid}/{fileName} {
      allow read: if true;
      allow write: if verifiedUser()
        && request.auth.uid == uid
        && (request.resource == null || validImageUpload());
    }

    match /room_owner_verifications/{uid}/{fileName} {
      allow read: if (verifiedUser() && request.auth.uid == uid) || isAdmin();
      allow write: if verifiedUser()
        && request.auth.uid == uid
        && (request.resource == null || validImageUpload());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
